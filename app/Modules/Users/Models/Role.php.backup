<?php

namespace App\Modules\Users\Models;

use Illuminate\Database\Eloquent\Model;  // ← IMPORTANT: Utilisez Model au lieu de SpatieRole
use Illuminate\Database\Eloquent\SoftDeletes;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;
use App\Modules\Shared\Models\Pivots\UserRole;

class Role extends Model  // ← CHANGEMENT ICI: extends Model, pas SpatieRole
{
    use SoftDeletes;

    protected $table = 'roles';

    /**
     * Champs remplissables en masse.
     */
    protected $fillable = [
        'name',
        'description',
        'created_by',
        'updated_by',
    ];

    protected $casts = [
        'created_at' => 'datetime',
        'updated_at' => 'datetime',
        'deleted_at' => 'datetime',
    ];

    /**
     * Relation avec la table pivot UserRole
     */
    public function userRoles(): HasMany
    {
        return $this->hasMany(UserRole::class);
    }

    /**
     * Relation avec les utilisateurs via la table pivot
     * Cette méthode doit retourner BelongsToMany pour être compatible
     */
    public function users()
    {
        return $this->belongsToMany(
            \App\Modules\Users\Models\User::class,  // Modèle User
            'user_roles',                           // Table pivot
            'role_id',                              // Clé étrangère du rôle dans la table pivot
            'user_id'                               // Clé étrangère de l'utilisateur dans la table pivot
        )
        ->using(UserRole::class)                    // Utiliser le modèle pivot personnalisé
        ->withPivot('school_id', 'created_by', 'updated_by', 'deleted_at')
        ->withTimestamps();
    }

    /**
     * Relation avec l'utilisateur qui a créé ce rôle
     */
    public function createdBy(): BelongsTo
    {
        return $this->belongsTo(User::class, 'created_by');
    }

    /**
     * Relation avec l'utilisateur qui a modifié ce rôle
     */
    public function updatedBy(): BelongsTo
    {
        return $this->belongsTo(User::class, 'updated_by');
    }

    /**
     * Scope pour filtrer par nom
     */
    public function scopeByName($query, $name)
    {
        return $query->where('name', $name);
    }

    /**
     * Vérifie si ce rôle est assignable à une école
     */
    public function isSchoolAssignable(): bool
    {
        // Exemple: certains rôles comme 'superadmin' ne devraient pas être liés à une école
        $nonSchoolRoles = ['super_admin', 'system_admin'];
        return !in_array($this->name, $nonSchoolRoles);
    }
}